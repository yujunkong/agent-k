{
  "$schema": "./settings.schema.json",
  "_comment": "Project overrides VS Code user/workspace settings. Do not put API keys here — use Settings → Provider.",
  "provider": {
    "type": "litellm",
    "baseUrl": "http://127.0.0.1:52415",
    "model": "mlx-community/Qwen3.6-35B-A3B-4bit"
  },
  "thinking": {
    "effort": "medium"
  },
  "maxTurns": 40,
  "permission": {
    "level": "accept_edits"
  },
  "queue": {
    "onEnterWhileRunning": "resynthesize",
    "onStop": "keep",
    "resynthesizeDebounceMs": 300
  },
  "context": {
    "readMaxLines": 5000
  },
  "harness": {
    "enabled": true,
    "verificationFirst": true,
    "prefetchEnabled": true
  },
  "features": {
    "browser": true,
    "mcp": true,
    "skills": true
  }
}
