{
  "name": "agent-k",
  "displayName": "Agent K",
  "description": "AI Coding Agent with local model harness (Flash-tier reliable via verification loops)",
  "version": "0.0.2",
  "publisher": "agent-k",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning"
  ],
  "activationEvents": [
    "onView:agent-k.chat",
    "onStartupFinished",
    "onCommand:agent-k.openSettings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-k",
          "title": "Agent K",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agent-k": [
        {
          "type": "webview",
          "id": "agent-k.chat",
          "name": "Chat",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "agent-k.chat.new",
        "title": "New Chat",
        "icon": "$(add)"
      },
      {
        "command": "agent-k.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "agent-k.provider.add",
        "title": "Add Provider",
        "icon": "$(cloud-add)"
      },
      {
        "command": "agent-k.mode.switch",
        "title": "Switch Mode",
        "icon": "$(symbol-method)"
      },
      {
        "command": "agent-k.chat.focusInput",
        "title": "Focus Chat Input"
      },
      {
        "command": "agent-k.chat.attachSelection",
        "title": "Agent K: Attach Selection to Chat",
        "icon": "$(mention)"
      },
      {
        "command": "agent-k.plan.open",
        "title": "Plan Mode: Create Plan",
        "icon": "$(book)"
      },
      {
        "command": "agent-k.plan.build",
        "title": "Agent K: Build Plan",
        "icon": "$(play)"
      },
      {
        "command": "agent-k.plan.openReview",
        "title": "Agent K: Open Plan Review",
        "icon": "$(eye)"
      },
      {
        "command": "agent-k.debug.open",
        "title": "Debug Mode: Start Debugging",
        "icon": "$(bug)"
      },
      {
        "command": "agent-k.review.open",
        "title": "Review: Code Review Session",
        "icon": "$(check-all)"
      },
      {
        "command": "agent-k.browser.open",
        "title": "Browser: Open Browser Session",
        "icon": "$(browser)"
      },
      {
        "command": "agent-k.artifacts.open",
        "title": "Artifacts: Open Gallery",
        "icon": "$(file-media)"
      },
      {
        "command": "agent-k.mcp.reload",
        "title": "MCP: Reload Servers",
        "icon": "$(debug-reconnect)"
      },
      {
        "command": "agent-k.mcp.connect",
        "title": "MCP: Connect Server",
        "icon": "$(plug)"
      },
      {
        "command": "agent-k.mcp.disconnect",
        "title": "MCP: Disconnect All",
        "icon": "$(debug-disconnect)"
      }
    ],
    "configuration": {
      "title": "Agent K",
      "properties": {
        "agent-k.provider.type": {
          "type": "string",
          "enum": [
            "litellm",
            "openai",
            "anthropic",
            "ollama",
            "lmstudio"
          ],
          "default": "litellm",
          "description": "LLM provider type"
        },
        "agent-k.provider.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "description": "Base URL for OpenAI-compatible API (LiteLLM proxy → MLX)"
        },
        "agent-k.provider.model": {
          "type": "string",
          "default": "qwen3.6-35b-a3b",
          "description": "Model name/identifier (LiteLLM alias or mlx-community/Qwen3.6-35B-A3B-4bit)"
        },
        "agent-k.provider.apiKey": {
          "type": "string",
          "default": "sk-agent-k-local",
          "description": "API key (LiteLLM master_key or empty for direct MLX)",
          "secret": true
        },
        "agent-k.thinking.effort": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "high"
          ],
          "default": "medium",
          "description": "Thinking / reasoning effort (Off · Low · Medium · High). Affects Thought depth for models that support enable_thinking / reasoning_effort."
        },
        "agent-k.mode.default": {
          "type": "string",
          "enum": [
            "ask",
            "agent",
            "plan",
            "debug"
          ],
          "default": "agent",
          "description": "Default chat mode"
        },
        "agent-k.maxTurns": {
          "type": "integer",
          "default": 25,
          "minimum": 5,
          "maximum": 100,
          "description": "Maximum agent-loop turns per run (Ask/Agent/Plan/Debug). Small/local models usually need 25–40; raise if you hit Max turns often."
        },
        "agent-k.permission.level": {
          "type": "string",
          "enum": [
            "ask",
            "accept_edits",
            "auto",
            "bypass"
          ],
          "default": "accept_edits",
          "description": "Permission gate level (product default: accept_edits per PRD-29)"
        },
        "agent-k.queue.onEnterWhileRunning": {
          "type": "string",
          "enum": [
            "resynthesize",
            "queue_only"
          ],
          "default": "resynthesize",
          "description": "Enter while agent running: Interrupt & Resynthesize (default) or queue only"
        },
        "agent-k.queue.onStop": {
          "type": "string",
          "enum": [
            "keep",
            "discard"
          ],
          "default": "keep",
          "description": "Queue policy when user hits Stop"
        },
        "agent-k.queue.resynthesizeDebounceMs": {
          "type": "integer",
          "default": 300,
          "minimum": 0,
          "maximum": 5000,
          "description": "Debounce for Interrupt & Resynthesize (PRD-17 NFR-03)"
        },
        "agent-k.context.budget": {
          "type": "integer",
          "default": 100000,
          "description": "Fallback context token budget when the provider does not report max_input_tokens / context length for the selected model"
        },
        "agent-k.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable telemetry collection"
        },
        "agent-k.budget.dailyTokens": {
          "type": "integer",
          "default": 10000000,
          "description": "Daily token budget"
        },
        "agent-k.budget.monthlyTokens": {
          "type": "integer",
          "default": 100000000,
          "description": "Monthly token budget"
        },
        "agent-k.mcp.servers": {
          "type": "object",
          "description": "MCP servers (Continue/OpenCode-style map). Each key is the server id; command may be a full argv array.",
          "default": {
            "searxng": {
              "type": "local",
              "command": [
                "python3",
                "/Users/kong-yujun/mcp-servers/searxng_mcp_server.py"
              ],
              "enabled": true
            },
            "sequential-thinking": {
              "type": "local",
              "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
              ],
              "enabled": true
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "local | remote (informational)"
              },
              "command": {
                "description": "Executable + args as array, or command string with separate args",
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                ]
              },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "transport": {
                "type": "string",
                "enum": ["stdio", "http"],
                "default": "stdio"
              },
              "url": {
                "type": "string"
              },
              "framing": {
                "type": "string",
                "enum": ["auto", "ndjson", "content-length"],
                "default": "auto",
                "description": "stdio framing (default ndjson; set content-length for SDK-strict servers)"
              }
            }
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "agent-k.chat.new",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.openSettings",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.mode.switch",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.provider.add",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.chat.focusInput",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.chat.attachSelection",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-k.chat.new",
          "when": "view == agent-k.chat",
          "group": "navigation"
        },
        {
          "command": "agent-k.openSettings",
          "when": "view == agent-k.chat",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "agent-k.plan.build",
          "when": "agent-k.isPlanDocument",
          "group": "navigation@1"
        },
        {
          "command": "agent-k.plan.openReview",
          "when": "agent-k.isPlanDocument",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "agent-k.chat.attachSelection",
          "when": "editorHasSelection",
          "group": "agent-k@1"
        },
        {
          "command": "agent-k.plan.build",
          "when": "agent-k.isPlanDocument",
          "group": "agent-k@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && npm run build:webview",
    "build:webview": "vite build",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "vite build --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run build:webview",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:harness": "node --import tsx ./node_modules/mocha/bin/mocha.js --ui tdd --extension ts 'tests/acceptance/harness/ac*.spec.ts'",
    "dev:webview": "vite"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.21"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  },
  "dependencies": {
    "@types/mermaid": "^9.1.0",
    "@types/uuid": "^10.0.0",
    "mermaid": "^11.16.0",
    "shiki": "1.27",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
