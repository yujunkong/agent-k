{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm:compile",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "compile"],
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc", "$esbuild"],
      "detail": "Compile extension + webview"
    },
    {
      "label": "npm:watch",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "watch"],
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "build",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch", "$esbuild-watch"],
      "detail": "Watch for changes and rebuild"
    },
    {
      "label": "npm:pretest",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "pretest"],
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "test",
      "detail": "Compile tests and extension"
    }
  ]
}
