{
  "name": "@agent-k/chat-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Webview React UI ported from v2.1-PRODUCTION-MODE (chat + settings + CSS).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "build:single": "AK_WEBVIEW_BUILD=single node esbuild.mjs",
    "build:chunks": "AK_WEBVIEW_BUILD=chunks node esbuild.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-k/shared": "*",
    "@agent-k/plan": "*",
    "mermaid": "^11.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^1.27.0",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
