{
  "name": "agent-k",
  "displayName": "Agent K",
  "description": "Agent-K v3.0 assembler \u2014 activation, Chat View, commands (EXT-001~005)",
  "version": "0.0.0",
  "private": true,
  "publisher": "agent-k",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:agent-k.chat",
    "onCommand:agent-k.chat.new",
    "onCommand:agent-k.openSettings",
    "onCommand:agent-k.openProjectConfig",
    "onCommand:agent-k.provider.add",
    "onCommand:agent-k.mode.switch",
    "onCommand:agent-k.chat.focusInput",
    "onCommand:agent-k.chat.attachSelection",
    "onCommand:agent-k.clipboardCopyWithPath",
    "onCommand:agent-k.clipboardCutWithPath",
    "onCommand:agent-k.inlineEdit",
    "onCommand:agent-k.plan.open",
    "onCommand:agent-k.plan.build",
    "onCommand:agent-k.plan.openReview",
    "onCommand:agent-k.debug.open",
    "onCommand:agent-k.review.open",
    "onCommand:agent-k.browser.open",
    "onCommand:agent-k.artifacts.open",
    "onCommand:agent-k.mcp.reload",
    "onCommand:agent-k.mcp.connect",
    "onCommand:agent-k.mcp.disconnect",
    "onCommand:agent-k.bestOfN.run"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-k",
          "title": "Agent K",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agent-k": [
        {
          "type": "webview",
          "id": "agent-k.chat",
          "name": "Chat",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "agent-k.chat.new",
        "title": "New Chat",
        "icon": "$(add)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.openProjectConfig",
        "title": "Open Project Config (.agentk/settings.json)",
        "icon": "$(json)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.provider.add",
        "title": "Add Provider",
        "icon": "$(cloud-add)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.mode.switch",
        "title": "Switch Mode",
        "icon": "$(symbol-method)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.chat.focusInput",
        "title": "Focus Chat Input",
        "category": "Agent K"
      },
      {
        "command": "agent-k.chat.attachSelection",
        "title": "Attach Selection to Chat",
        "icon": "$(mention)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.clipboardCopyWithPath",
        "title": "Copy (capture path for Chat)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.clipboardCutWithPath",
        "title": "Cut (capture path for Chat)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.inlineEdit",
        "title": "Inline Edit",
        "icon": "$(edit)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.plan.open",
        "title": "Plan Mode: Create Plan",
        "icon": "$(book)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.plan.build",
        "title": "Build Plan",
        "icon": "$(play)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.plan.openReview",
        "title": "Open Plan Review",
        "icon": "$(eye)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.debug.open",
        "title": "Debug Mode: Start Debugging",
        "icon": "$(bug)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.review.open",
        "title": "Code Review Session",
        "icon": "$(check-all)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.browser.open",
        "title": "Open Browser Session",
        "icon": "$(browser)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.artifacts.open",
        "title": "Open Artifacts Gallery",
        "icon": "$(file-media)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.mcp.reload",
        "title": "MCP: Reload Servers",
        "icon": "$(debug-reconnect)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.mcp.connect",
        "title": "MCP: Connect Server",
        "icon": "$(plug)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.mcp.disconnect",
        "title": "MCP: Disconnect All",
        "icon": "$(debug-disconnect)",
        "category": "Agent K"
      },
      {
        "command": "agent-k.bestOfN.run",
        "title": "Run Best-of-N",
        "icon": "$(git-compare)",
        "category": "Agent K"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-k.chat.new",
          "when": "view == agent-k.chat",
          "group": "navigation"
        },
        {
          "command": "agent-k.openSettings",
          "when": "view == agent-k.chat",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "agent-k.plan.build",
          "when": "agent-k.isPlanDocument",
          "group": "navigation@1"
        },
        {
          "command": "agent-k.plan.openReview",
          "when": "agent-k.isPlanDocument",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "agent-k.inlineEdit",
          "when": "editorHasSelection",
          "group": "agent-k@0"
        },
        {
          "command": "agent-k.chat.attachSelection",
          "when": "editorHasSelection",
          "group": "agent-k@1"
        },
        {
          "command": "agent-k.plan.build",
          "when": "agent-k.isPlanDocument",
          "group": "agent-k@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agent-k.chat.new",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.openSettings",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.mode.switch",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.provider.add",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.chat.focusInput",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "view == agent-k.chat"
      },
      {
        "command": "agent-k.chat.attachSelection",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection"
      },
      {
        "command": "agent-k.clipboardCopyWithPath",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "agent-k.clipboardCutWithPath",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Agent K",
      "properties": {
        "agent-k.provider.type": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "litellm",
            "openai",
            "anthropic",
            "ollama",
            "lmstudio",
            "opencode-zen",
            "opencode-go"
          ],
          "description": "Active provider type (set via Settings → AI Providers)."
        },
        "agent-k.provider.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible provider base URL (set in Settings)."
        },
        "agent-k.provider.model": {
          "type": "string",
          "default": "",
          "description": "Active chat model id (from discovery / connection)."
        },
        "agent-k.provider.apiKey": {
          "type": "string",
          "default": "",
          "description": "Provider API key (optional for local servers)."
        },
        "agent-k.provider.apiKeys": {
          "type": "object",
          "default": {},
          "description": "Per-provider API keys map."
        },
        "agent-k.provider.models": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Legacy model id list (synced with availableModels)."
        },
        "agent-k.provider.availableModels": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Discovered / registered model ids for Composer."
        },
        "agent-k.provider.connections": {
          "type": "array",
          "default": [],
          "description": "Saved provider connections (Settings → AI Providers)."
        },
        "agent-k.provider.profiles": {
          "type": "array",
          "default": [],
          "description": "Provider profiles."
        },
        "agent-k.provider.activeProfileId": {
          "type": "string",
          "default": "",
          "description": "Active provider profile id."
        },
        "agent-k.provider.preferUserOrder": {
          "type": "boolean",
          "default": false,
          "description": "Prefer user connection order when resolving models."
        },
        "agent-k.context.budget": {
          "type": "number",
          "default": 100000,
          "description": "Context token budget fallback."
        },
        "agent-k.permission.level": {
          "type": "string",
          "default": "accept_edits",
          "description": "Permission gate level."
        },
        "agent-k.telemetry.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show usage on the status bar."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "node -e \"console.log('@agent-k EXT-001~005 assembler OK')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-k/host": "*",
    "@agent-k/shared": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
